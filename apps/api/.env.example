# Copy this file to `.env` in the same directory and fill in real values.
# Every variable without a default in src/config/env.ts is REQUIRED —
# the server refuses to start if one is missing.

NODE_ENV=development

# Required. Port the API listens on.
PORT=4000

# Required. Origin(s) allowed to call this API (the admin-web dev server, for now).
CORS_ORIGIN=http://localhost:5173

# Optional, defaults to "info". One of: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info

# Required. MySQL connection string. See README.md "Local database" for how to start one
# (Docker via infrastructure/docker/docker-compose.yml, or apps/api/scripts/dev-mysql-sandbox.sh
# if Docker isn't available). Same port (3307) either way.
DATABASE_URL=mysql://gym_app:gym_app_dev_pw@127.0.0.1:3307/gym_dev
