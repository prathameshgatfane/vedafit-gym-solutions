# Copy this file to `.env` in the same directory and fill in real values.
# Every variable without a default in src/config/env.ts is REQUIRED —
# the server refuses to start if one is missing.

NODE_ENV=development

# Required. Port the API listens on.
PORT=4000

# Required. Origin(s) allowed to call this API (the admin-web dev server, for now).
CORS_ORIGIN=http://localhost:5173

# Optional, defaults to "info". One of: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info
