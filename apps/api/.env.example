# Copy this file to `.env` in the same directory and fill in real values.
# Every variable without a default in src/config/env.ts is REQUIRED —
# the server refuses to start if one is missing.

NODE_ENV=development

# Required. Port the API listens on.
PORT=4000

# Required. Origin(s) allowed to call this API (the admin-web dev server, for now).
CORS_ORIGIN=http://localhost:5173

# Optional, defaults to "info". One of: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info

# Required. MySQL connection string. See README.md "Local database" for how to start one
# (Docker via infrastructure/docker/docker-compose.yml, or apps/api/scripts/dev-mysql-sandbox.sh
# if Docker isn't available). Same port (3307) either way.
DATABASE_URL=mysql://gym_app:gym_app_dev_pw@127.0.0.1:3307/gym_dev

# Required. Signing key for access JWTs — minimum 32 characters. Generate a real one per
# environment with: openssl rand -base64 48
# Rotating this invalidates every issued access token (refresh tokens survive, since they're
# opaque random values stored hashed in the DB, not JWTs).
JWT_SECRET=local-dev-only-secret-change-me-0123456789abcdef

# Optional. Access token lifetime (any `ms`/jsonwebtoken duration string). Keep it short —
# the refresh cookie is what keeps sessions alive.
JWT_ACCESS_TTL=15m

# Optional. Refresh token (httpOnly cookie) lifetime in days.
REFRESH_TOKEN_TTL_DAYS=30

# Optional. How long a password reset link stays valid, in minutes.
PASSWORD_RESET_TTL_MINUTES=30

# Optional. Domain to scope the refresh cookie to. Leave unset to use the request host.
# COOKIE_DOMAIN=localhost

# Optional. Failed logins per IP+email before the login endpoint returns 429.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
