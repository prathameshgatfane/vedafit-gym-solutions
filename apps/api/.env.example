# Copy this file to `.env` in the same directory and fill in real values.
# Every variable without a default in src/config/env.ts is REQUIRED —
# the server refuses to start if one is missing.

# development | test | production. Staff and platform refresh cookies are
# Secure only when this is production.
NODE_ENV=development

# Required. Port the API listens on.
PORT=4000

# Required. Comma-separated browser-origin allowlist (1.23.5). localhost and
# 127.0.0.1 are different origins — list both for each local app:
#   admin-web :5173, super-admin :5174, Flutter Web :8080.
# Do not use * — credentialed requests (staff/platform refresh cookies) cannot
# use a wildcard origin. A later production deploy must list that host's real
# origins here; do not invent one now.
# Refresh cookies are Secure only when NODE_ENV=production (plain HTTP localhost
# would drop a Secure cookie).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8080,http://127.0.0.1:8080

# Optional, defaults to "info". One of: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info

# Required. MySQL connection string. See README.md "Local database" for how to start one
# (Docker via infrastructure/docker/docker-compose.yml, or apps/api/scripts/dev-mysql-sandbox.sh
# if Docker isn't available). Same port (3307) either way.
DATABASE_URL=mysql://gym_app:gym_app_dev_pw@127.0.0.1:3307/gym_dev

# Required. Signing key for access JWTs — minimum 32 characters. Generate a real one per
# environment with: openssl rand -base64 48
# Rotating this invalidates every issued access token (refresh tokens survive, since they're
# opaque random values stored hashed in the DB, not JWTs).
JWT_SECRET=local-dev-only-secret-change-me-0123456789abcdef

# Optional. Access token lifetime (any `ms`/jsonwebtoken duration string). Keep it short —
# the refresh cookie is what keeps sessions alive.
JWT_ACCESS_TTL=15m

# Optional. Refresh token (httpOnly cookie) lifetime in days.
REFRESH_TOKEN_TTL_DAYS=30

# Optional. How long a password reset link stays valid, in minutes.
PASSWORD_RESET_TTL_MINUTES=30

# Optional. Domain to scope the refresh cookie to. Leave unset to use the request host.
# COOKIE_DOMAIN=localhost

# Optional. Seed-only platform operator (Phase 15.1). Not used at runtime by the API.
# SEED_PLATFORM_PASSWORD=ChangeMe123!

# Optional. Failed logins per IP+email before the login endpoint returns 429.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Optional. Public POST /api/v1/platform/signup attempts per IP (successes count) before 429.
SIGNUP_RATE_LIMIT_MAX=5
SIGNUP_RATE_LIMIT_WINDOW_MINUTES=15

# Optional. Trial subscription length in days for POST /platform/signup (Phase 15.5).
SAAS_TRIAL_DAYS=14

# ── Notifications / queue (Phase 12) ──────────────────────────────────────────
# Required the same way MySQL is: the nightly job and the send worker are not
# optional adapters. Default matches docker-compose and scripts/dev-redis-sandbox.sh.
REDIS_URL=redis://127.0.0.1:6379

# Optional. BullMQ key prefix. Tests force `gym-test` so they cannot consume a
# `pnpm dev` queue (Locked Decision 1.22.3).
QUEUE_PREFIX=gym

# Optional. Send-job retries and the first backoff delay. 3 × exponential from 10s
# is the decision, not BullMQ's defaults.
NOTIFICATION_ATTEMPTS=3
NOTIFICATION_BACKOFF_MS=10000

# Optional. Gym-local hour (0–23) that counts as "nightly". A 15-minute tick runs
# the scan for any ACTIVE org whose local hour matches (1.22.4).
NIGHTLY_LOCAL_HOUR=21
