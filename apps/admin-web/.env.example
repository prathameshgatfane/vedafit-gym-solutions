# Copy this file to `.env` in the same directory and fill in real values.
# Only vars prefixed with VITE_ are exposed to client code (Vite convention).
# Anything without a default in src/lib/env.ts is REQUIRED — the app throws a
# clear error at boot if it's missing.

# Required. Base URL of the API (apps/api).
VITE_API_URL=http://localhost:4000/api/v1
